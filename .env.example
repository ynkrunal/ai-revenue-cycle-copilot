# Copy to .env and adjust. Never commit .env.
# Folder the generator writes Parquet files to (dbt reads from here too).
RCM_RAW_DIR=data/raw
# DuckDB file that dbt builds and training reads.
RCM_DUCKDB_PATH=data/rcm.duckdb
# Where training writes the model, metrics.json and worklist.csv.
RCM_ARTIFACTS_DIR=models/artifacts
